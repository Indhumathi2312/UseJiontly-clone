{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/layout.jsx", "app/page.jsx", "components/FAQ.jsx", "components/Footer.jsx", "components/Hero.jsx", "components/HowTo.jsx", "components/LaunchApp.jsx", "components/Nav.jsx", "components/Payoff.jsx", "components/Testimonials.jsx", "components/Toolkit.jsx", "components/WhyPitch.jsx"],
  "exclude": ["node_modules"]
}
